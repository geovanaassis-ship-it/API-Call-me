# Banco de dados PostgreSQL
# Local via docker-compose: já vem pré-configurado abaixo.
# Free hosting (Neon/Supabase): cole a connection string fornecida por eles.
DATABASE_URL="postgresql://ri_agenda:ri_agenda@localhost:5432/ri_agenda?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Gere um valor aleatório forte, ex: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-e-secreto"

# URL pública da aplicação (usada em links de e-mail, cancelamento etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Usuário único do setor de R.I. (usado pelo script de seed: npm run seed)
RI_ADMIN_NAME="Relações com Investidores - More Invest"
RI_ADMIN_EMAIL="ri@moreinvest.com.br"
RI_ADMIN_PASSWORD="troque-por-uma-senha-forte"

# SMTP para envio de e-mails de confirmação/cancelamento (opcional, mas recomendado)
# Ex: Gmail com senha de app, SendGrid, Amazon SES, etc.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Fuso horário padrão usado na formatação de e-mails
RI_DEFAULT_TIMEZONE="America/Sao_Paulo"
